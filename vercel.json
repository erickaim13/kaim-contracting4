{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/stain-removal",
      "destination": "/gutter-brightening",
      "permanent": true
    },
    {
      "source": "/landscaping",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/drainage",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pavers",
      "destination": "/paver-sealing",
      "permanent": true
    },
    {
      "source": "/paver-calculator",
      "destination": "/paver-sealing-calculator",
      "permanent": true
    },
    {
      "source": "/mulch-calculator",
      "destination": "/tools",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/queue-health",
      "schedule": "0 11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/blog?sitemap=1"
    }
  ],
  "functions": {
    "api/blog.js": {
      "includeFiles": "blog-*template.html"
    }
  }
}
